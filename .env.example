# Where the orchestrator backend lives, including the /api suffix.
VITE_MFE_BACKEND_URL=https://console.mfe-orchestrator.dev/api

# Id of your project in the orchestrator.
VITE_MFE_PROJECT_ID=

# Environment slug, ex. DEV / STAGE / PROD. OPTIONAL: leave it unset (or delete the line) and
# the backend resolves the environment from the domain this app is served on, out of the domains
# declared for each environment in the console. Set it to pin one environment explicitly.
VITE_MFE_ENVIRONMENT=
